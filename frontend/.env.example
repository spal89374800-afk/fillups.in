# ========================================================
# 🎨 FRONTEND ENVIRONMENT (Vite)
# ========================================================
# Copy this file to `.env.local` and change values if needed.
#
# VITE_API_URL: Backend URL used when the frontend is opened from a separate
# static/frontend Render URL. Leave it as the main Render service URL so login
# and OTP work from both URLs.
#
# If the same Express server serves both the site and the API, this can also be
# left empty — relative `/api/...` calls will be used.
VITE_API_URL="https://fillups-in.onrender.com"
