# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; never commit real credentials.

# GEMINI_API_KEY: Required for Gemini AI API calls.
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# GEMINI_MODEL: Gemini model id. Free tier is fine; update here if Google changes models.
GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"
PORT=3000

# Gmail OTP delivery (use a Google App Password; never commit real credentials).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-gmail-address@gmail.com"
SMTP_PASS="your-gmail-app-password"

# Government UPI (citizen pays the government fee directly here — never to the operator)
GOVT_UPI_ID="government-upi-id@bank"
GOVT_UPI_NAME="Government Fee"

# Admin UPI (receives the website maintenance commission) and commission rate
ADMIN_UPI_ID="your-admin-upi@bank"
ADMIN_UPI_NAME="DigiSeva Admin"
ADMIN_COMMISSION_PERCENT=17
# ADMIN_TOKEN: secret required (via x-admin-token header or adminToken body) to
# confirm the admin-fee leg of a split payment. Change from the default.
ADMIN_TOKEN="my-secret-admin-token"

# Backend & integrations
JWT_SECRET="fillup_secure_jwt_secret_key"
REDIS_URL="redis://localhost:6379/0"
MONGODB_URI="mongodb://localhost:27017/fillup_db"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# WhatsApp Cloud API OTP delivery (OPTIONAL). Meta requires an approved OTP
# template for business-initiated messages. Leave blank to use Gmail only.
WHATSAPP_API_KEY="your-whatsapp-business-api-token"
WHATSAPP_PHONE_NUMBER_ID="your-whatsapp-phone-number-id"
WHATSAPP_OTP_TEMPLATE_NAME="your-approved-otp-template-name"
WHATSAPP_OTP_TEMPLATE_LANGUAGE="en_US"
WHATSAPP_API_VERSION="v22.0"

# WebRTC ICE servers (JSON). Configure a TURN server for reliable mobile/NAT connections.
WEBRTC_ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"replace-with-turn-username","credential":"replace-with-turn-credential"}]'

# TEST_OTP_ENABLED: when true (and NODE_ENV is not production), OTP is returned
# in the API response and auto-filled instead of being sent via Gmail/WhatsApp.
TEST_OTP_ENABLED=true

# ========================================================
# 🛡️ CLOUDFLARE SECURITY (bot + DDoS protection)
# ========================================================
# Cloudflare dashboard → Turnstile → Add widget → Managed → copy the keys.
# Site key browser ko jaata hai (public), secret key server par hi rahega.
# Blank chhodne par Turnstile skip ho jata hai (local dev ke liye theek hai).
TURNSTILE_SITE_KEY="MY_TURNSTILE_SITE_KEY"
TURNSTILE_SECRET_KEY="MY_TURNSTILE_SECRET_KEY"

# Bot shield thresholds (0-100 score). Score >= BLOCK_SCORE par request 403.
BOT_SHIELD_BLOCK_SCORE=70
BOT_SHIELD_SUSPICIOUS_SCORE=40
# Sirf in countries ke requests allow (comma separated). Country Cloudflare
# ke `cf-ipcountry` header se aata hai. Bina Cloudflare ke header nahi aata.
BOT_SHIELD_ALLOWED_COUNTRIES="IN"
# BOT_SHIELD_DEBUG=true karne par har request ka score console me print hoga.
BOT_SHIELD_DEBUG=false

# Partner / webhook secrets (live deploy par ZAROORI hai — default fallback
# hataya gaya hai, key na ho to partner endpoints fail closed rahenge).
PARTNER_API_KEY="MY_PARTNER_API_KEY"
PARTNER_WEBHOOK_SIGNATURE="MY_PARTNER_WEBHOOK_SIGNATURE"
